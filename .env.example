# ==========================================
# CareFlow SaaS - Environment Configuration
# ==========================================

# Backend Configuration
PORT=5000
NODE_ENV=development
# Standalone MongoDB URI (If empty or unreachable, the system automatically runs an embedded in-memory MongoDB engine)
MONGODB_URI=mongodb://127.0.0.1:27017/careflow_db
JWT_SECRET=careflow_super_secret_jwt_key_2026_dev
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Notification Service Credentials (Leave empty to use built-in Mock Providers)
WHATSAPP_API_KEY=
WHATSAPP_PHONE_ID=
SMS_API_KEY=
SMS_SENDER_ID=CAREFLOW
EMAIL_API_KEY=
EMAIL_FROM=no-reply@careflow.com

# Frontend Configuration
VITE_API_URL=/api
